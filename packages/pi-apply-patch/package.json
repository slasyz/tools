{
	"name": "pi-apply-patch",
	"version": "0.1.2",
	"description": "Codex-style apply_patch tool extension for the pi coding agent. Registers a freeform grammar patch tool for OpenAI GPT models and applies patches with Node path resolution.",
	"keywords": [
		"apply-patch",
		"codex",
		"coding-agent",
		"gpt",
		"openai",
		"pi",
		"pi-coding-agent",
		"pi-extension",
		"pi-mono",
		"typescript"
	],
	"license": "MIT",
	"type": "module",
	"main": "./index.ts",
	"exports": {
		".": "./index.ts"
	},
	"scripts": {
		"test": "vitest --run",
		"test:watch": "vitest",
		"typecheck": "tsgo --noEmit",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"lint": "oxlint src test",
		"lint:fix": "oxlint --fix src test",
		"check": "tsgo --noEmit && oxlint src test && oxfmt --check ."
	},
	"dependencies": {
		"diff": "^9.0.0",
		"pi-sandbox": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"oxfmt": "^0.47.0",
		"oxlint": "^1.85.0",
		"typescript": "7.0.2",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	}
}
